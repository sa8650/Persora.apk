<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Persora" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/persora_bg</item>
    </style>

    <!-- System splash (Android 12+) hands off to the Compose boot screen, which mirrors PersoraBootScreen.tsx -->
    <style name="Theme.Persora.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/persora_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_core</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Persora</item>
    </style>
</resources>
